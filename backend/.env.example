# Generate a long random value, for example:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=replace_with_a_long_random_secret
AUTH_TOKEN_EXPIRE_HOURS=24

# Live weather and historical weather use Open-Meteo without a key.
# When set, current weather and the five-day forecast use OpenWeatherMap.
# Get a free key from data.gov.in for official daily mandi prices.
DEMO_MODE=false
WEATHER_API_KEY=your_openweathermap_api_key_optional
DATA_GOV_API_KEY=your_data_gov_in_api_key
OPENAI_API_KEY=
# Only required if your network uses a corporate HTTPS-inspection certificate.
HTTP_CA_BUNDLE=
